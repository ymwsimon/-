Dialogue: Marked=0,0:00:01.10,0:00:03.70,*Default,NTP,0000,0000,0000,,人世謂緣
Dialogue: Marked=0,0:00:04.70,0:00:06.50,*Default,NTP,0000,0000,0000,,繫結的絲線糾結纏繞
Dialogue: Marked=0,0:00:06.80,0:00:08.70,*Default,NTP,0000,0000,0000,,脆弱可悲的彼岸花
Dialogue: Marked=0,0:00:09.30,0:00:13.10,*Default,NTP,0000,0000,0000,,在憤怒 悲傷 淚水中度日
Dialogue: Marked=0,0:00:13.90,0:00:16.00,*Default,NTP,0000,0000,0000,,午夜零點的帷幕彼方
Dialogue: Marked=0,0:00:16.70,0:00:19.90,*Default,NTP,0000,0000,0000,,難消之恨 願爲消之
Dialogue: Marked=0,0:00:23.30,0:00:28.20,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K30}いつか{\K80}光{\K40}に向{\K40}か{\K60}う　{\K60\K30}逆{\K90}さまの{\K60}蝶
Dialogue: Marked=0,0:00:28.50,0:00:33.40,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K40}君{\K20}と{\K40}髪{\K50}を{\K30}切{\K60}る　{\K30\K80}鏡{\K40}の{\K100}中
Dialogue: Marked=0,0:00:33.70,0:00:39.10,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K60}授業{\K50}中{\K60}の{\K80}廊下　{\K80\K40}響{\K40}く{\K100}足音
Dialogue: Marked=0,0:00:39.40,0:00:44.50,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K20}絶{\K20}えず{\K30}雨{\K40}の{\K60}音{\K60}が　{\K20\K40}つい{\K50}て{\K40\K40}くる{\K50}よ
Dialogue: Marked=0,0:00:44.80,0:00:49.70,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K20}感{\K30}じ{\K45}る{\K45}まま{\K30}の{\K70\K60}形{\K40}は{\K60}眩{\K60}しい
Dialogue: Marked=0,0:00:50.00,0:00:55.00,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K20}甘{\K30}い{\K50}花{\K50}にな{\K80}る　{\K20\K30}毒{\K10}の{\K10}実{\K10}に{\K60}も{\K60}なる
Dialogue: Marked=0,0:00:55.30,0:01:00.30,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K40}今日{\K60}も{\K120}雨　{\K40\K40}あの{\K120}日と今{\K40}を
Dialogue: Marked=0,0:01:00.50,0:01:04.30,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K30}空{\K30}と{\K30}空{\K30}で{\K30}つ{\K60}なぎ{\K80}た{\K30}い{\K60}の
Dialogue: Marked=0,0:01:04.80,0:01:07.60,*Default,NTP,0000,0000,0000,,{\fad(200,200)\K20}In {\K30}this {\K60}Craziness,{\K30\K90}Uncertainty
Dialogue: Marked=0,0:01:07.80,0:01:10.40,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K20}一人{\K60}一人{\K40}の{\K60}思{\K30}い{\K30}を
Dialogue: Marked=0,0:01:10.60,0:01:15.40,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K30}僕{\K40}ら{\K50}は{\K30}どこ{\K40}か{\K50}に{\K40}残{\K40}せる{\K60}だ{\K40}ろう{\K60}か
Dialogue: Marked=0,0:01:15.70,0:01:18.00,*Default,NTP,0000,0000,0000,,{\fad(200,200)\K20}In {\K30}this {\K60}Craziness,{\K20\K40}You {\K40}gave me {\K20}life
Dialogue: Marked=0,0:01:18.20,0:01:20.90,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K160}ひとつの{\K60}思{\K30}い{\K30}を
Dialogue: Marked=0,0:01:21.10,0:01:26.40,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K30}僕{\K40}ら{\K50}は{\K30}どこ{\K40}ま{\K50}で{\K40}守{\K40}れる{\K60}だ{\K40}ろう{\K60}か
Dialogue: Marked=0,0:01:26.70,0:01:29.00,*Default,NTP,0000,0000,0000,,{\fad(200,200)\K5}In {\K20}this {\K50}Craziness,{\K30\K90}Uncertainty
Dialogue: Marked=0,0:01:29.10,0:01:31.70,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K20}一人{\K60}一人{\K40}の{\K60}形{\K30}を
Dialogue: Marked=0,0:01:31.90,0:01:37.20,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K30}僕{\K40}ら{\K50}は{\K30}どこ{\K40}か{\K50}に{\K40}残{\K40}せる{\K60}だ{\K40}ろう{\K60}か
Dialogue: Marked=0,0:01:37.40,0:01:39.50,*Default,NTP,0000,0000,0000,,{\fad(200,200)\K5}In {\K10}this {\K50}Craziness,{\K20\K40}You {\K40}gave me {\K20}life
Dialogue: Marked=0,0:01:39.90,0:01:42.50,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K140}それぞれの{\K60}形{\K30}を
Dialogue: Marked=0,0:01:42.70,0:01:47.60,*Default,NTP,0000,0000,0000,,{\fad(200,200)\fn华文细黑\K30}僕{\K40}ら{\K50}は{\K30}どこ{\K40}ま{\K50}で{\K40}守{\K40}れる{\K60}だ{\K40}ろう{\K60}か
Dialogue: Marked=0,0:02:08.60,0:02:09.60,Default,,0000,0000,0000,,救救我
Dialogue: Marked=0,0:02:12.55,0:02:17.54,Default,,0000,0000,0000,,{\c&H0000FF&}玻璃風景
Dialogue: Marked=0,0:02:35.30,0:02:36.50,Default,,0000,0000,0000,,我討厭霧
Dialogue: Marked=0,0:02:38.40,0:02:40.90,Default,,0000,0000,0000,,不知道前路有什麼而感到不安
Dialogue: Marked=0,0:02:46.30,0:02:47.90,Default,,0000,0000,0000,,看清前路的話
Dialogue: Marked=0,0:02:48.30,0:02:50.70,Default,,0000,0000,0000,,有討厭的事情也會努力
Dialogue: Marked=0,0:02:55.30,0:02:57.00,Default,,0000,0000,0000,,小孩兒別想那些煩心事
Dialogue: Marked=0,0:02:57.60,0:02:58.60,Default,,0000,0000,0000,,我纔不是小孩
Dialogue: Marked=0,0:02:58.70,0:03:00.00,Default,,0000,0000,0000,,怎麼看都是小孩
Dialogue: Marked=0,0:03:00.30,0:03:02.10,Default,,0000,0000,0000,,我可是阿一的監護人哦
Dialogue: Marked=0,0:03:02.30,0:03:03.30,Default,,0000,0000,0000,,哦 是嘛
Dialogue: Marked=0,0:03:06.20,0:03:07.20,Default,,0000,0000,0000,,小心點
Dialogue: Marked=0,0:03:07.50,0:03:08.70,Default,,0000,0000,0000,,別飈那麼快
Dialogue: Marked=0,0:03:08.80,0:03:10.80,Default,,0000,0000,0000,,是是 監護人
Dialogue: Marked=0,0:03:23.10,0:03:23.80,Default,,0000,0000,0000,,八音盒
Dialogue: Marked=0,0:03:27.40,0:03:28.30,Default,,0000,0000,0000,,從哪裏傳來的
Dialogue: Marked=0,0:03:29.00,0:03:30.60,Default,,0000,0000,0000,,也不像是外面的
Dialogue: Marked=0,0:03:31.40,0:03:32.60,Default,,0000,0000,0000,,收音機開着嗎
Dialogue: Marked=0,0:03:34.90,0:03:35.50,Default,,0000,0000,0000,,危險
Dialogue: Marked=0,0:03:44.20,0:03:44.80,Default,,0000,0000,0000,,沒事吧
Dialogue: Marked=0,0:03:45.40,0:03:46.10,Default,,0000,0000,0000,,不要去
Dialogue: Marked=0,0:03:47.80,0:03:48.40,Default,,0000,0000,0000,,回去
Dialogue: Marked=0,0:03:49.50,0:03:50.10,Default,,0000,0000,0000,,不要去
Dialogue: Marked=0,0:03:50.60,0:03:51.50,Default,,0000,0000,0000,,閻魔愛嗎
Dialogue: Marked=0,0:04:04.70,0:04:06.00,Default,,0000,0000,0000,,靜養院
Dialogue: Marked=0,0:04:17.10,0:04:18.40,Default,,0000,0000,0000,,勞駕
Dialogue: Marked=0,0:04:19.20,0:04:20.20,Default,,0000,0000,0000,,有人嗎
Dialogue: Marked=0,0:04:26.40,0:04:28.20,Default,,0000,0000,0000,,啊 勞駕
Dialogue: Marked=0,0:04:28.50,0:04:29.60,Default,,0000,0000,0000,,阿一
Dialogue: Marked=0,0:04:36.60,0:04:38.70,Default,,0000,0000,0000,,什麼人也沒有
Dialogue: Marked=0,0:04:44.80,0:04:45.50,Default,,0000,0000,0000,,回去吧
Dialogue: Marked=0,0:04:47.50,0:04:48.30,Default,,0000,0000,0000,,不要緊
Dialogue: Marked=0,0:04:53.80,0:04:54.90,Default,,0000,0000,0000,,你肯定嗎
Dialogue: Marked=0,0:04:56.00,0:04:57.10,Default,,0000,0000,0000,,那個八音盒聲
Dialogue: Marked=0,0:04:56.00,0:04:57.10,Default,,0000,0000,0000,,{\an8\fs18}音樂是G弦上的詠歎調 作曲J.S.Bach
Dialogue: Marked=0,0:04:57.40,0:04:59.40,Default,,0000,0000,0000,,在我看見的景色裏也迴響着
Dialogue: Marked=0,0:04:59.70,0:05:01.20,Default,,0000,0000,0000,,這種事早說啊
Dialogue: Marked=0,0:05:01.70,0:05:02.10,Default,,0000,0000,0000,,對不起
Dialogue: Marked=0,0:05:02.70,0:05:03.20,Default,,0000,0000,0000,,別的呢
Dialogue: Marked=0,0:05:04.20,0:05:05.40,Default,,0000,0000,0000,,救命
Dialogue: Marked=0,0:05:06.90,0:05:08.50,Default,,0000,0000,0000,,女孩的聲音
Dialogue: Marked=0,0:05:08.90,0:05:10.10,Default,,0000,0000,0000,,說救命
Dialogue: Marked=0,0:05:18.90,0:05:21.60,Default,,0000,0000,0000,,果然還是一個人也沒有的樣子
Dialogue: Marked=0,0:05:23.20,0:05:24.60,Default,,0000,0000,0000,,轉一圈就回去吧
Dialogue: Marked=0,0:05:53.40,0:05:53.90,Default,,0000,0000,0000,,怎麼樣
Dialogue: Marked=0,0:05:54.50,0:05:55.70,Default,,0000,0000,0000,,和你看到的景色一樣嗎
Dialogue: Marked=0,0:05:56.30,0:05:57.40,Default,,0000,0000,0000,,有點不一樣
Dialogue: Marked=0,0:05:57.60,0:05:58.00,Default,,0000,0000,0000,,不一樣
Dialogue: Marked=0,0:05:59.00,0:06:01.10,Default,,0000,0000,0000,,外面的風景是一樣的
Dialogue: Marked=0,0:06:01.40,0:06:03.20,Default,,0000,0000,0000,,可是覺得有什麼不同
Dialogue: Marked=0,0:06:04.60,0:06:05.50,Default,,0000,0000,0000,,是嗎
Dialogue: Marked=0,0:06:08.30,0:06:10.50,Default,,0000,0000,0000,,也許是因爲某種原因才發出聲音的吧
Dialogue: Marked=0,0:06:11.10,0:06:12.20,Default,,0000,0000,0000,,好了 走吧
Dialogue: Marked=0,0:06:21.30,0:06:22.00,Default,,0000,0000,0000,,你是
Dialogue: Marked=0,0:06:30.90,0:06:31.90,Default,,0000,0000,0000,,你好
Dialogue: Marked=0,0:06:39.80,0:06:42.40,Default,,0000,0000,0000,,是嗎 你叫妮娜啊
Dialogue: Marked=0,0:06:42.90,0:06:43.30,Default,,0000,0000,0000,,是
Dialogue: Marked=0,0:06:43.70,0:06:44.90,Default,,0000,0000,0000,,我叫鶇
Dialogue: Marked=0,0:06:45.40,0:06:46.50,Default,,0000,0000,0000,,小鶇
Dialogue: Marked=0,0:06:47.90,0:06:49.40,Default,,0000,0000,0000,,他是我爸爸
Dialogue: Marked=0,0:06:51.50,0:06:54.40,Default,,0000,0000,0000,,爸爸 真好啊
Dialogue: Marked=0,0:06:56.00,0:06:58.50,Default,,0000,0000,0000,,妮娜 沒有爸爸
Dialogue: Marked=0,0:07:02.40,0:07:03.90,Default,,0000,0000,0000,,這裏挺安靜啊
Dialogue: Marked=0,0:07:05.10,0:07:05.70,Default,,0000,0000,0000,,是
Dialogue: Marked=0,0:07:06.00,0:07:07.40,Default,,0000,0000,0000,,其他的患者呢
Dialogue: Marked=0,0:07:07.70,0:07:09.10,Default,,0000,0000,0000,,現在只有妮娜
Dialogue: Marked=0,0:07:10.00,0:07:10.80,Default,,0000,0000,0000,,是這樣啊
Dialogue: Marked=0,0:07:11.70,0:07:13.70,Default,,0000,0000,0000,,醫生和護士們呢
Dialogue: Marked=0,0:07:14.60,0:07:16.30,Default,,0000,0000,0000,,從剛纔起就沒看見
Dialogue: Marked=0,0:07:17.40,0:07:18.10,Default,,0000,0000,0000,,有啊
Dialogue: Marked=0,0:07:24.70,0:07:25.40,Default,,0000,0000,0000,,原來有啊
Dialogue: Marked=0,0:07:26.10,0:07:27.20,Default,,0000,0000,0000,,我去打個招呼
Dialogue: Marked=0,0:07:29.50,0:07:30.60,Default,,0000,0000,0000,,你們來做什麼啊
Dialogue: Marked=0,0:07:32.40,0:07:34.10,Default,,0000,0000,0000,,來這裏有事吧
Dialogue: Marked=0,0:07:34.80,0:07:39.10,Default,,0000,0000,0000,,那個 爸爸是這裏的院長的朋友
Dialogue: Marked=0,0:07:39.40,0:07:40.80,Default,,0000,0000,0000,,因爲正好到附近了
Dialogue: Marked=0,0:07:40.90,0:07:43.10,Default,,0000,0000,0000,,就決定順便拜訪一下
Dialogue: Marked=0,0:07:47.50,0:07:48.90,Default,,0000,0000,0000,,真奇怪
Dialogue: Marked=0,0:07:49.40,0:07:50.50,Default,,0000,0000,0000,,明明是朝這邊來的
Dialogue: Marked=0,0:08:06.60,0:08:07.40,Default,,0000,0000,0000,,請問
Dialogue: Marked=0,0:08:27.90,0:08:30.30,Default,,0000,0000,0000,,妮娜 眼睛的顏色好漂亮
Dialogue: Marked=0,0:08:30.90,0:08:31.70,Default,,0000,0000,0000,,謝謝
Dialogue: Marked=0,0:08:32.10,0:08:33.20,Default,,0000,0000,0000,,頭髮也好漂亮
Dialogue: Marked=0,0:08:33.50,0:08:34.60,Default,,0000,0000,0000,,你可以摸一下哦
Dialogue: Marked=0,0:08:36.00,0:08:36.70,Default,,0000,0000,0000,,可以的
Dialogue: Marked=0,0:08:48.10,0:08:49.30,Default,,0000,0000,0000,,好順滑
Dialogue: Marked=0,0:08:55.20,0:08:56.60,Default,,0000,0000,0000,,暖暖的
Dialogue: Marked=0,0:08:58.50,0:09:00.20,Default,,0000,0000,0000,,手怎麼冷冷的
Dialogue: Marked=0,0:09:14.30,0:09:15.50,Default,,0000,0000,0000,,招呼打了嗎
Dialogue: Marked=0,0:09:17.90,0:09:20.50,Default,,0000,0000,0000,,院長今天可能外出了
Dialogue: Marked=0,0:09:21.20,0:09:23.20,Default,,0000,0000,0000,,週末經常外出的
Dialogue: Marked=0,0:09:24.60,0:09:25.50,Default,,0000,0000,0000,,院長是
Dialogue: Marked=0,0:09:28.30,0:09:28.80,Default,,0000,0000,0000,,什麼啊
Dialogue: Marked=0,0:09:29.10,0:09:30.00,Default,,0000,0000,0000,,一會再說
Dialogue: Marked=0,0:09:32.00,0:09:33.50,Default,,0000,0000,0000,,今天你們住在這裏吧
Dialogue: Marked=0,0:09:34.60,0:09:36.80,Default,,0000,0000,0000,,有很多空房間 沒關係的
Dialogue: Marked=0,0:09:37.50,0:09:39.30,Default,,0000,0000,0000,,妮娜會幫你們安排的
Dialogue: Marked=0,0:09:40.70,0:09:41.20,Default,,0000,0000,0000,,可是
Dialogue: Marked=0,0:09:41.30,0:09:44.40,Default,,0000,0000,0000,,抱歉 我們在鎮上預定了房間
Dialogue: Marked=0,0:09:45.10,0:09:45.80,Default,,0000,0000,0000,,沒可能的
Dialogue: Marked=0,0:09:48.90,0:09:50.60,Default,,0000,0000,0000,,霧這麼大 回不去的
Dialogue: Marked=0,0:10:07.10,0:10:08.10,Default,,0000,0000,0000,,是那孩子嗎
Dialogue: Marked=0,0:10:08.70,0:10:10.70,Default,,0000,0000,0000,,登錄了地獄通信的
Dialogue: Marked=0,0:10:11.20,0:10:11.80,Default,,0000,0000,0000,,也許
Dialogue: Marked=0,0:10:12.50,0:10:14.10,Default,,0000,0000,0000,,我從剛纔就到處瞄了幾眼
Dialogue: Marked=0,0:10:14.60,0:10:16.60,Default,,0000,0000,0000,,這房裏似乎沒有電腦
Dialogue: Marked=0,0:10:20.20,0:10:23.50,Default,,0000,0000,0000,,而且這個靜養院本身就很可疑
Dialogue: Marked=0,0:10:24.40,0:10:25.40,Default,,0000,0000,0000,,那孩子是誰
Dialogue: Marked=0,0:10:26.10,0:10:28.90,Default,,0000,0000,0000,,不 對什麼懷着怨恨呢
Dialogue: Marked=0,0:10:31.40,0:10:32.30,Default,,0000,0000,0000,,而且那孩子
Dialogue: Marked=0,0:10:32.40,0:10:33.20,Default,,0000,0000,0000,,別說了
Dialogue: Marked=0,0:10:46.40,0:10:47.60,Default,,0000,0000,0000,,對不起
Dialogue: Marked=0,0:10:48.60,0:10:49.80,Default,,0000,0000,0000,,別再想了吧
Dialogue: Marked=0,0:10:50.80,0:10:53.40,Default,,0000,0000,0000,,我想回去 阿一
Dialogue: Marked=0,0:10:54.80,0:10:55.40,Default,,0000,0000,0000,,回去吧
Dialogue: Marked=0,0:10:56.30,0:10:57.90,Default,,0000,0000,0000,,等霧散了馬上就走
Dialogue: Marked=0,0:11:05.80,0:11:07.00,Default,,0000,0000,0000,,事到如今
Dialogue: Marked=0,0:11:07.20,0:11:08.90,Default,,0000,0000,0000,,看來不是偶然的
Dialogue: Marked=0,0:11:10.10,0:11:12.20,Default,,0000,0000,0000,,那個叫柴田的記者
Dialogue: Marked=0,0:11:12.70,0:11:16.10,Default,,0000,0000,0000,,肯定是依據事前到手的情報行動的
Dialogue: Marked=0,0:11:16.50,0:11:17.80,Default,,0000,0000,0000,,那果然是
Dialogue: Marked=0,0:11:18.60,0:11:19.30,Default,,0000,0000,0000,,小姐
Dialogue: Marked=0,0:11:22.40,0:11:23.70,Default,,0000,0000,0000,,但這是爲了什麼呢
Dialogue: Marked=0,0:11:24.40,0:11:25.50,Default,,0000,0000,0000,,不知道
Dialogue: Marked=0,0:11:25.80,0:11:29.80,Default,,0000,0000,0000,,或許小姐本人也是無意識地在這麼做
Dialogue: Marked=0,0:11:30.40,0:11:34.80,Default,,0000,0000,0000,,老實說 最近小姐真讓人搞不懂
Dialogue: Marked=0,0:11:35.20,0:11:36.20,Default,,0000,0000,0000,,確實是
Dialogue: Marked=0,0:11:37.00,0:11:38.70,Default,,0000,0000,0000,,這次的事也是
Dialogue: Marked=0,0:11:39.00,0:11:42.50,Default,,0000,0000,0000,,啊 沒想到會接受這種委託
Dialogue: Marked=0,0:11:43.50,0:11:45.80,Default,,0000,0000,0000,,來自靈魂的訪問
Dialogue: Marked=0,0:11:52.10,0:11:53.60,Default,,0000,0000,0000,,地獄少女
Dialogue: Marked=0,0:11:56.80,0:11:59.90,Default,,0000,0000,0000,,這麼遲 我都等不及了
Dialogue: Marked=0,0:12:12.20,0:12:14.70,Default,,0000,0000,0000,,我無法接受你的委託
Dialogue: Marked=0,0:12:16.50,0:12:18.10,Default,,0000,0000,0000,,無法接受是什麼意思
Dialogue: Marked=0,0:12:18.90,0:12:20.60,Default,,0000,0000,0000,,你不是會爲我消除怨恨嗎
Dialogue: Marked=0,0:12:21.10,0:12:22.60,Default,,0000,0000,0000,,那不是你的工作嗎
Dialogue: Marked=0,0:12:24.00,0:12:26.00,Default,,0000,0000,0000,,你的怨恨無法消除
Dialogue: Marked=0,0:12:29.30,0:12:30.10,Default,,0000,0000,0000,,等等
Dialogue: Marked=0,0:12:32.20,0:12:33.60,Default,,0000,0000,0000,,等一下啊 地獄少女
Dialogue: Marked=0,0:12:38.80,0:12:39.40,Default,,0000,0000,0000,,妮娜
Dialogue: Marked=0,0:12:41.30,0:12:42.20,Default,,0000,0000,0000,,騙子
Dialogue: Marked=0,0:12:43.70,0:12:45.20,Default,,0000,0000,0000,,妮娜
Dialogue: Marked=0,0:12:46.60,0:12:48.80,Default,,0000,0000,0000,,你剛纔說地獄少女
Dialogue: Marked=0,0:12:49.50,0:12:50.90,Default,,0000,0000,0000,,不過 算了
Dialogue: Marked=0,0:12:51.80,0:12:52.50,Default,,0000,0000,0000,,沒關係了
Dialogue: Marked=0,0:12:53.10,0:12:55.20,Default,,0000,0000,0000,,因爲現在的妮娜有
Dialogue: Marked=0,0:13:00.80,0:13:02.50,Default,,0000,0000,0000,,好像肚子餓了
Dialogue: Marked=0,0:13:02.90,0:13:04.10,Default,,0000,0000,0000,,去喫飯吧
Dialogue: Marked=0,0:13:05.30,0:13:06.00,Default,,0000,0000,0000,,走吧
Dialogue: Marked=0,0:13:18.20,0:13:19.60,Default,,0000,0000,0000,,來 喫吧
Dialogue: Marked=0,0:13:21.90,0:13:22.80,Default,,0000,0000,0000,,怎麼了
Dialogue: Marked=0,0:13:23.10,0:13:24.30,Default,,0000,0000,0000,,快點快點
Dialogue: Marked=0,0:13:31.70,0:13:33.30,Default,,0000,0000,0000,,那我去泡茶吧
Dialogue: Marked=0,0:13:34.30,0:13:35.10,Default,,0000,0000,0000,,謝謝
Dialogue: Marked=0,0:13:37.30,0:13:40.40,Default,,0000,0000,0000,,小鶇的爸爸真體貼啊
Dialogue: Marked=0,0:13:43.20,0:13:45.40,Default,,0000,0000,0000,,跟妮娜的爸爸是天壤之別
Dialogue: Marked=0,0:13:46.20,0:13:50.10,Default,,0000,0000,0000,,妮娜的爸爸扔下妮娜走了
Dialogue: Marked=0,0:13:50.80,0:13:51.70,Default,,0000,0000,0000,,是嗎
Dialogue: Marked=0,0:13:52.20,0:13:53.10,Default,,0000,0000,0000,,媽媽呢
Dialogue: Marked=0,0:13:54.30,0:13:55.20,Default,,0000,0000,0000,,媽媽
Dialogue: Marked=0,0:13:56.00,0:13:57.00,Default,,0000,0000,0000,,可能有過
Dialogue: Marked=0,0:13:57.90,0:13:59.40,Default,,0000,0000,0000,,我不知道媽媽
Dialogue: Marked=0,0:14:04.50,0:14:06.80,Default,,0000,0000,0000,,妮娜 可以問你點問題嗎
Dialogue: Marked=0,0:14:07.10,0:14:07.80,Default,,0000,0000,0000,,什麼
Dialogue: Marked=0,0:14:08.40,0:14:09.20,Default,,0000,0000,0000,,要是不願意
Dialogue: Marked=0,0:14:09.40,0:14:10.60,Default,,0000,0000,0000,,可以不回答
Dialogue: Marked=0,0:14:11.20,0:14:13.40,Default,,0000,0000,0000,,你登錄了地獄通信吧
Dialogue: Marked=0,0:14:13.60,0:14:14.90,Default,,0000,0000,0000,,地獄通信
Dialogue: Marked=0,0:14:15.20,0:14:16.10,Default,,0000,0000,0000,,嗯 連過啊
Dialogue: Marked=0,0:14:17.10,0:14:18.40,Default,,0000,0000,0000,,對誰心懷怨恨
Dialogue: Marked=0,0:14:18.90,0:14:19.30,Default,,0000,0000,0000,,嗯
Dialogue: Marked=0,0:14:19.70,0:14:21.00,Default,,0000,0000,0000,,是嗎 對誰
Dialogue: Marked=0,0:14:21.70,0:14:22.50,Default,,0000,0000,0000,,爸爸
Dialogue: Marked=0,0:14:25.70,0:14:27.80,Default,,0000,0000,0000,,拋下我一個人好寂寞
Dialogue: Marked=0,0:14:28.10,0:14:30.10,Default,,0000,0000,0000,,都是爸爸不好
Dialogue: Marked=0,0:14:30.30,0:14:31.60,Default,,0000,0000,0000,,我一直這樣想
Dialogue: Marked=0,0:14:33.60,0:14:35.10,Default,,0000,0000,0000,,不過已經沒關係了
Dialogue: Marked=0,0:14:36.40,0:14:38.10,Default,,0000,0000,0000,,現在已經不寂寞了
Dialogue: Marked=0,0:14:38.50,0:14:39.80,Default,,0000,0000,0000,,有小鶇在
Dialogue: Marked=0,0:14:40.10,0:14:41.90,Default,,0000,0000,0000,,還有了新的爸爸
Dialogue: Marked=0,0:14:44.00,0:14:46.10,Default,,0000,0000,0000,,你們永遠和我在一起吧
Dialogue: Marked=0,0:14:46.60,0:14:49.20,Default,,0000,0000,0000,,不會丟下妮娜一個人吧
Dialogue: Marked=0,0:14:49.90,0:14:52.10,Default,,0000,0000,0000,,你在說什麼 妮娜
Dialogue: Marked=0,0:14:52.40,0:14:57.50,Default,,0000,0000,0000,,妮娜 我們只是路過和院長打個招呼
Dialogue: Marked=0,0:14:58.00,0:15:00.10,Default,,0000,0000,0000,,沒有什麼院長啊
Dialogue: Marked=0,0:15:02.70,0:15:05.80,Default,,0000,0000,0000,,這裏除了妮娜以外 什麼人也沒有
Dialogue: Marked=0,0:15:09.70,0:15:12.90,Default,,0000,0000,0000,,從今以後我們三人一起好好生活吧
Dialogue: Marked=0,0:15:13.20,0:15:15.40,Default,,0000,0000,0000,,因爲我們是一家人嘛
Dialogue: Marked=0,0:15:16.20,0:15:17.10,Default,,0000,0000,0000,,妮娜
Dialogue: Marked=0,0:15:19.60,0:15:21.20,Default,,0000,0000,0000,,對嗎 小鶇
Dialogue: Marked=0,0:15:25.60,0:15:26.90,Default,,0000,0000,0000,,阿一
Dialogue: Marked=0,0:15:27.60,0:15:28.60,Default,,0000,0000,0000,,小鶇
Dialogue: Marked=0,0:15:29.00,0:15:29.70,Default,,0000,0000,0000,,怎麼了
Dialogue: Marked=0,0:15:29.90,0:15:31.00,Default,,0000,0000,0000,,不要過來
Dialogue: Marked=0,0:15:35.40,0:15:37.40,Default,,0000,0000,0000,,妮娜 你
Dialogue: Marked=0,0:15:37.70,0:15:38.40,Default,,0000,0000,0000,,一樣
Dialogue: Marked=0,0:15:40.50,0:15:42.10,Default,,0000,0000,0000,,和爸爸一樣
Dialogue: Marked=0,0:15:47.80,0:15:48.40,Default,,0000,0000,0000,,鶇
Dialogue: Marked=0,0:15:50.50,0:15:51.50,Default,,0000,0000,0000,,不能原諒
Dialogue: Marked=0,0:15:54.60,0:15:56.10,Default,,0000,0000,0000,,就這樣跑到車子那裏
Dialogue: Marked=0,0:15:57.50,0:15:58.60,Default,,0000,0000,0000,,阿一
Dialogue: Marked=0,0:16:11.30,0:16:13.10,Default,,0000,0000,0000,,雖說是小姐的命令
Dialogue: Marked=0,0:16:13.50,0:16:15.70,Default,,0000,0000,0000,,想不到變成救了那傢伙
Dialogue: Marked=0,0:16:16.30,0:16:19.30,Default,,0000,0000,0000,,他們和這個委託沒有關係
Dialogue: Marked=0,0:16:20.00,0:16:21.10,Default,,0000,0000,0000,,這是什麼
Dialogue: Marked=0,0:16:22.30,0:16:23.00,Default,,0000,0000,0000,,鶇
Dialogue: Marked=0,0:16:23.30,0:16:24.20,Default,,0000,0000,0000,,鶇
Dialogue: Marked=0,0:16:37.30,0:16:38.60,Default,,0000,0000,0000,,阿一
Dialogue: Marked=0,0:16:39.80,0:16:40.50,Default,,0000,0000,0000,,阿一
Dialogue: Marked=0,0:16:56.40,0:16:57.80,Default,,0000,0000,0000,,是你不好哦
Dialogue: Marked=0,0:16:58.00,0:16:58.70,Default,,0000,0000,0000,,鶇
Dialogue: Marked=0,0:17:00.10,0:17:02.60,Default,,0000,0000,0000,,來吧 跟妮娜一起吧
Dialogue: Marked=0,0:17:06.00,0:17:06.70,Default,,0000,0000,0000,,你是
Dialogue: Marked=0,0:17:10.10,0:17:10.70,Default,,0000,0000,0000,,你好
Dialogue: Marked=0,0:17:26.30,0:17:27.30,Default,,0000,0000,0000,,鶇
Dialogue: Marked=0,0:17:34.50,0:17:36.10,Default,,0000,0000,0000,,鶇 喂
Dialogue: Marked=0,0:17:41.80,0:17:42.70,Default,,0000,0000,0000,,太好了
Dialogue: Marked=0,0:17:51.90,0:17:52.80,Default,,0000,0000,0000,,發動
Dialogue: Marked=0,0:17:53.20,0:17:54.40,Default,,0000,0000,0000,,給我發動啊這個破爛
Dialogue: Marked=0,0:18:11.40,0:18:12.10,Default,,0000,0000,0000,,可惡
Dialogue: Marked=0,0:18:12.30,0:18:13.40,Default,,0000,0000,0000,,不要
Dialogue: Marked=0,0:18:20.20,0:18:21.00,Default,,0000,0000,0000,,住手
Dialogue: Marked=0,0:18:30.00,0:18:30.90,Default,,0000,0000,0000,,住手
Dialogue: Marked=0,0:18:36.40,0:18:38.70,Default,,0000,0000,0000,,地獄少女
Dialogue: Marked=0,0:18:49.20,0:18:49.70,Default,,0000,0000,0000,,鶇
Dialogue: Marked=0,0:18:51.70,0:18:54.20,Default,,0000,0000,0000,,地獄少女
Dialogue: Marked=0,0:18:57.60,0:19:00.30,Default,,0000,0000,0000,,你沒有消除妮娜的怨恨
Dialogue: Marked=0,0:19:01.00,0:19:02.40,Default,,0000,0000,0000,,已經沒你的事了
Dialogue: Marked=0,0:19:02.80,0:19:03.70,Default,,0000,0000,0000,,不要妨礙我
Dialogue: Marked=0,0:19:04.40,0:19:07.10,Default,,0000,0000,0000,,住手 不能把他們捲進來
Dialogue: Marked=0,0:19:07.80,0:19:09.30,Default,,0000,0000,0000,,是鶇他們不好
Dialogue: Marked=0,0:19:09.70,0:19:11.80,Default,,0000,0000,0000,,又要丟下妮娜一個人
Dialogue: Marked=0,0:19:12.40,0:19:13.80,Default,,0000,0000,0000,,像妮娜的爸爸一樣
Dialogue: Marked=0,0:19:14.10,0:19:15.60,Default,,0000,0000,0000,,又讓妮娜孤單一人
Dialogue: Marked=0,0:19:17.40,0:19:18.80,Default,,0000,0000,0000,,你不是妮娜
Dialogue: Marked=0,0:19:20.70,0:19:22.40,Default,,0000,0000,0000,,你 說什麼
Dialogue: Marked=0,0:19:22.90,0:19:24.00,Default,,0000,0000,0000,,我是妮娜啊
Dialogue: Marked=0,0:19:24.70,0:19:25.90,Default,,0000,0000,0000,,回憶下試試
Dialogue: Marked=0,0:19:42.40,0:19:45.40,Default,,0000,0000,0000,,你的主人已經死了
Dialogue: Marked=0,0:19:51.30,0:19:52.00,Default,,0000,0000,0000,,妮娜
Dialogue: Marked=0,0:20:24.70,0:20:25.20,Default,,0000,0000,0000,,鶇
Dialogue: Marked=0,0:20:25.70,0:20:27.00,Default,,0000,0000,0000,,鶇 喂
Dialogue: Marked=0,0:20:48.10,0:20:49.30,Default,,0000,0000,0000,,怎麼回事
Dialogue: Marked=0,0:20:49.90,0:20:50.60,Default,,0000,0000,0000,,不知道
Dialogue: Marked=0,0:21:07.60,0:21:08.40,Default,,0000,0000,0000,,是這裏
Dialogue: Marked=0,0:21:09.80,0:21:12.00,Default,,0000,0000,0000,,我看到的景像
Dialogue: Marked=0,0:21:23.70,0:21:24.60,Default,,0000,0000,0000,,洋娃娃
Dialogue: Marked=0,0:21:39.70,0:21:41.00,Default,,0000,0000,0000,,我在這裏啊
Dialogue: Marked=0,0:21:41.70,0:21:42.70,Default,,0000,0000,0000,,我會等着的
Dialogue: Marked=0,0:21:43.90,0:21:46.00,Default,,0000,0000,0000,,乖乖地等着的
Dialogue: Marked=0,0:21:46.90,0:21:47.50,Default,,0000,0000,0000,,所以 
Dialogue: Marked=0,0:21:48.50,0:21:51.30,Default,,0000,0000,0000,,回到我身邊吧 爸爸
Dialogue: Marked=0,0:21:52.10,0:21:53.60,Default,,0000,0000,0000,,我不要一個人
Dialogue: Marked=0,0:21:54.50,0:21:55.70,Default,,0000,0000,0000,,好寂寞啊
Dialogue: Marked=0,0:21:58.30,0:21:59.50,Default,,0000,0000,0000,,救救我
Dialogue: Marked=0,0:22:04.00,0:22:07.00,Default,,0000,0000,0000,,她把妮娜的記憶
Dialogue: Marked=0,0:23:14.80,0:23:20.70,*Default,NTP,0000,0000,0000,,{\fn华文细黑\K20}い{\K30}つ{\K30}だっ{\K200}て　{\K30}行{\K30}き{\K30}止{\K30}まり{\K200}で
Dialogue: Marked=0,0:23:21.30,0:23:28.00,*Default,NTP,0000,0000,0000,,{\fn华文细黑\K60}決{\K20}し{\K100}て　{\K40}逃{\K45}げ{\K40}ら{\K40}れ{\K70}な{\K200}い
Dialogue: Marked=0,0:23:28.20,0:23:41.40,*Default,NTP,0000,0000,0000,,{\fn华文细黑\K40}空{\K140}の{\K40}鳥{\K120}へ　{\K40}哀{\K40}し{\K80}み{\K80}の{\K200}せ　{\K100}飛{\K40}ば{\K80}す{\K200}の
Dialogue: Marked=0,0:23:45.30,0:23:48.80,*Default,NTP,0000,0000,0000,,{\fn华文细黑\K50}ここ{\K140}は{\K20}仮{\K70}縫{\K70}い
Dialogue: Marked=0,0:23:49.10,0:23:59.50,*Default,NTP,0000,0000,0000,,{\fn华文细黑\K210}私{\K180}を{\K60\K100}縛{\K60}る{\K30\K140}永{\K200}遠
Dialogue: Marked=0,0:24:00.10,0:24:06.30,*Default,NTP,0000,0000,0000,,{\fn华文细黑\K80}行{\K20}き{\K100}も{\K30\K100}帰{\K80}り{\K200}も
Dialogue: Marked=0,0:24:07.10,0:24:19.50,*Default,NTP,0000,0000,0000,,{\fn华文细黑\K40}過{\K30}ぎ{\K40}て{\K40\K240}ゆ{\K220}く{\K220}は{\K100}夢
Dialogue: Marked=0,0:24:29.95,0:24:31.95,*Default,NTP,0000,0000,0000,,本故事純屬虛構\N登場人物名 團體名等全部與現實無關
Dialogue: Marked=0,0:24:33.10,0:24:34.30,Default,,0000,0000,0000,,名字是
Dialogue: Marked=0,0:24:34.70,0:24:35.70,Default,,0000,0000,0000,,上川美紀
Dialogue: Marked=0,0:24:36.60,0:24:38.30,Default,,0000,0000,0000,,逃不掉嗎
Dialogue: Marked=0,0:24:38.70,0:24:40.40,Default,,0000,0000,0000,,那個女人每天都叫我去
Dialogue: Marked=0,0:24:41.40,0:24:43.50,Default,,0000,0000,0000,,那個女人只是爲了仇恨而活着
Dialogue: Marked=0,0:24:44.40,0:24:46.60,Default,,0000,0000,0000,,這樣下去 那小傢伙們就
Dialogue: Marked=0,0:24:47.40,0:24:48.90,Default,,0000,0000,0000,,願望是
Dialogue: Marked=0,0:24:49.70,0:24:52.60,Default,,0000,0000,0000,,把她流放到地獄
Dialogue: Marked=0,0:24:53.80,0:24:56.80,Default,,0000,0000,0000,,怨 恨 已 聞
Dialogue: Marked=0,0:24:57.00,0:25:02.00,Default,,0000,0000,0000,,{\an7\c&H0000FF&}下集
Dialogue: Marked=0,0:24:57.00,0:25:02.00,Default,,0000,0000,0000,,{\c&H0000FF&}被束縛的少女
